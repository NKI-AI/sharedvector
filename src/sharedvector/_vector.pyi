"""Type stub for the compiled ``sharedvector._vector`` extension."""

import numpy as np
import numpy.typing as npt

class SharedVector:
    def __init__(
        self,
        name: str,
        chunk_size: int = 1048576,
        max_memory_size: int = 10485760,
        dtype: str | None = None,
        create: bool = True,
    ) -> None: ...
    def __len__(self) -> int: ...
    def append(self, array: np.ndarray, meta: npt.NDArray[np.float64] | None = None) -> None: ...
    def get(self, index: int) -> np.ndarray: ...
    def get_meta(self, index: int) -> npt.NDArray[np.float64]: ...
    def get_chunk_pointer(self, index: int) -> int: ...
    def get_chunk_ref_count(self, index: int) -> int: ...
    def get_chunk_shape(self, index: int) -> tuple[int, ...]: ...
    def replace(self, index: int, array: np.ndarray, meta: npt.NDArray[np.float64] | None = None) -> None: ...
    def size(self) -> int: ...
    @property
    def dtype(self) -> str: ...
    @property
    def free_memory(self) -> int: ...
    @property
    def ref_count(self) -> int: ...

class MemoryError(Exception): ...
class OutOfMemoryError(MemoryError): ...
class InUseError(Exception): ...
class ArraySizeError(Exception): ...
class DataModifiedError(Exception): ...

def remove_shared_memory(name: str) -> None: ...
